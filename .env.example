# Supabase Configuration (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin Dashboard Credentials (used by POST /api/admin/login)
ADMIN_USER=admin
ADMIN_PASS=change-this-password
# Optional: secret used to sign admin session tokens (defaults to ADMIN_PASS)
ADMIN_SESSION_SECRET=

# Email Configuration (Resend or SMTP)
RESEND_API_KEY=re_123456789
